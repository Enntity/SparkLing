# SPDX-License-Identifier: AGPL-3.0-only
# SPARKLING_MODEL=ling-3.2-air (or ./start.sh --model)
# SPARKLING_MODEL=lingsante-3.1-air-vl selects LingSante. Strict uses the original BF16. Spark defaults to Enntity NVFP4.
# Set QUANT=publisher to select inclusionAI MXFP4 in Air-VL Spark mode.
# MODE=spark
# Spark mode runs Ling-3.2-air with NVFP4 prefill and decode by default; checkpoint follows the checkpoint.
# MODE=strict serves the original checkpoint with checkpoint precision.
# PREFILL_PRECISION=nvfp4
# DECODE_PRECISION=nvfp4
# Spark mode also accepts nvfp4 (attention) or nvfp4-head (attention and output head).
# Air-VL derived NVFP4 also accepts nvfp4-mlp-head and nvfp4-mlp-fp8-head.
# MODEL_ROOT=/srv/models/sparkling
# PROFILE=default
# DRAFTER=mtp
# Spark mode drafts with Ling-3.2-air’s embedded predictor by default (greedy text matches DRAFTER=none).
# Air-VL's NVFP4 Spark mode borrows that predictor (DRAFTER=ling-mtp). DRAFTER=none decodes plainly; Strict defaults to none.
# DRAFTER=ling-mtp borrows that predictor for the BF16-derived Air-VL NVFP4 target.
# GPU_MEMORY_UTILIZATION=0.89
# The disk prefix cache (evicted KV blocks and KDA state) is on by default:
# 48 GiB under MODEL_ROOT/prefix-cache. PREFIX_CACHE_GB=0 turns it off.
# PREFIX_CACHE_DIR=/srv/sparkling/prefix-cache
# PREFIX_CACHE_GB=48
# The KV cache borrows the GB10's 2 GiB display carveout when no other server
# holds it; DISPLAY_CARVEOUT=0 leaves it to the display.
# DISPLAY_CARVEOUT=1
# TOOL_GUARD=stream
# TOOL_GUARD_ALLOW_HOSTS=uploads.example.org
# TOOL_GUARD_DENY_HOSTS=blocked.example.org
# TOOL_GUARD_MAX_BYTES=1048576
# PULL=0
# ATLAS_BUILD_JOBS=4

# Optional Docker name for a reserved Spark.
# CONTAINER_NAME=atlas-sparkling
